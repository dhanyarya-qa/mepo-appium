# ──────────────────────────────────────────────
# Mepo Travel — Appium E2E test configuration
# Copy this file to `.env` and fill in real values.
# `.env` is git-ignored and must never be committed.
# ──────────────────────────────────────────────

# ── Appium / Device ──────────────────────────
APPIUM_SERVER_URL=http://127.0.0.1:4723
ANDROID_DEVICE_NAME=your_device_name
ANDROID_PLATFORM_VERSION=15
ANDROID_UDID=192.168.1.x:port        # Wireless ADB target (adb connect)
# ANDROID_HOME=C:\Users\<you>\AppData\Local\Android\Sdk

# ── Backend API ──────────────────────────────
MEPO_API_BASE_URL=https://dev.mepo.travel/api/v1
MEPO_TEST_USER_EMAIL=your_test_user@example.com
MEPO_TEST_USER_PASSWORD=your_password
MEPO_TEST_USER_TOKEN=your_api_token

# ── App UI login credentials ─────────────────
MEPO_LOGIN_EMAIL=your_login@example.com
MEPO_LOGIN_PASSWORD=your_password
